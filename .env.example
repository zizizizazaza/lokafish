# Loka — backend environment configuration
# Copy this file to .env and fill in your keys, then:
#   set -a && source .env && set +a
#   python backend/run.py

# ============================================================
# LLM provider — pick ONE, comment out the others
# ============================================================

# Option A: Aliyun DashScope / 通义千问 (recommended for China)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Option B: DeepSeek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

# Option C: OpenAI (needs VPN if you're in China)
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# ============================================================
# Zep Cloud — knowledge graph store
# Sign up at https://www.getzep.com → Project → API Keys
# ============================================================
ZEP_API_KEY=z_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Multi-LLM Pool (optional — for high-throughput 2000+ agent generation)
# Distribute LLM calls across multiple API endpoints to avoid rate limits.
# If not set, falls back to the single LLM_API_KEY above.
# ============================================================

# Comma-separated endpoint names
# LLM_POOL_ENDPOINTS=deepseek,qwen,openai

# Per-endpoint config: LLM_POOL_<NAME>_KEY, LLM_POOL_<NAME>_URL, LLM_POOL_<NAME>_MODEL
# LLM_POOL_DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_POOL_DEEPSEEK_URL=https://api.deepseek.com/v1
# LLM_POOL_DEEPSEEK_MODEL=deepseek-chat

# LLM_POOL_QWEN_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_POOL_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_POOL_QWEN_MODEL=qwen-plus

# LLM_POOL_OPENAI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_POOL_OPENAI_URL=https://api.openai.com/v1
# LLM_POOL_OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Agent generation target
# Group entities are amplified to reach this count.
# ============================================================
TARGET_AGENT_COUNT=2000

# ============================================================
# Optional Flask tuning
# ============================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false

# OASIS simulation defaults
OASIS_DEFAULT_MAX_ROUNDS=80

# ReportAgent tuning
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
