# Loka — backend environment configuration
# Copy this file to .env and fill in your keys, then:
#   set -a && source .env && set +a
#   python backend/run.py

# ============================================================
# LLM provider — pick ONE, comment out the others
# ============================================================

# Option A: Aliyun DashScope / 通义千问 (recommended for China)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Option B: DeepSeek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

# Option C: OpenAI (needs VPN if you're in China)
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# ============================================================
# Zep Cloud — knowledge graph store
# Sign up at https://www.getzep.com → Project → API Keys
# ============================================================
ZEP_API_KEY=z_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Optional Flask tuning
# ============================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false

# OASIS simulation defaults
OASIS_DEFAULT_MAX_ROUNDS=80

# ReportAgent tuning
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
