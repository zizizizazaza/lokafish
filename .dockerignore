# Files that should not be sent into the docker build context.
# Keeping this small makes builds dramatically faster.

node_modules
dist
dist-ssr
*.log

# Backend runtime artifacts
backend/.venv
backend/venv
backend/__pycache__
backend/**/__pycache__
backend/uploads
backend/logs
backend/*.log
*.pyc
*.pyo
.pytest_cache

# Editor + OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Git
.git
.gitignore

# Secrets — never bake into images
.env
.env.local
*.secret
secrets/

# Snapshots can be huge — exclude unless intentionally bundled
public/snapshots/raw
public/snapshots/charts
